# Chaves aceitas pelo provider-fake. Não são segredos reais: só funcionam contra ele.
FAKE_OPENAI_KEY=sk-fake-openai-0001
FAKE_ANTHROPIC_KEY=sk-ant-fake-0001

# Chave mestra do AI Gateway (LiteLLM). Também não é segredo real: só vale para o gateway local.
LITELLM_MASTER_KEY=sk-gateway-master-0001

# Virtual keys do gateway (criadas na subida a partir de gateway/keys.yaml).
HELPDESK_GATEWAY_KEY=sk-helpdesk-app-0001
DEMO_BUDGET_KEY=sk-demo-budget-0001
DEMO_RATE_LIMIT_KEY=sk-demo-rate-limit-0001

# Senha do banco do gateway (só existe na rede do compose).
GATEWAY_DB_PASSWORD=litellm-local-0001
